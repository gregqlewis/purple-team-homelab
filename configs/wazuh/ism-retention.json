{
  "policy": {
    "description": "Delete Wazuh alerts and archives after 90 days",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [{ "state_name": "delete", "conditions": { "min_index_age": "90d" } }]
      },
      {
        "name": "delete",
        "actions": [{ "delete": {} }],
        "transitions": []
      }
    ],
    "ism_template": [{ "index_patterns": ["wazuh-alerts-*", "wazuh-archives-*"], "priority": 1 }]
  }
}
